# Copy to .env and adjust. All optional — sensible local defaults exist.

# --- Storage ---
# Local Parquet lake (default) or an object store, e.g. s3://ma-lakehouse
# LAKE_URI=./data/lake

# --- Warehouse ---
# WAREHOUSE_TARGET=duckdb            # duckdb (default) | snowflake | bigquery
# DUCKDB_PATH=./data/warehouse/ecl.duckdb

# --- Business params ---
# REORDER_LEAD_TIME_DAYS=21
# HISTORY_DAYS=400
# RANDOM_SEED=42

# --- Source selection ---
# ECL_SOURCE=synthetic               # synthetic | csv

# --- Live marketplace credentials (only if using API connectors) ---
# AMZN_LWA_CLIENT_ID=
# AMZN_LWA_CLIENT_SECRET=
# AMZN_REFRESH_TOKEN=
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_OAUTH_TOKEN=
# ETSY_API_KEY=
# ETSY_OAUTH_TOKEN=
# ETSY_SHOP_ID=
# WALMART_CLIENT_ID=
# WALMART_CLIENT_SECRET=
# FAIRE_ACCESS_TOKEN=
